# Perfil: dev (SQL no log + Swagger) ou prod
AJT_PROFILE=dev

# Banco de dados
AJT_DB_URL=jdbc:postgresql://localhost:5454/ajt_db
AJT_DB_USER=postgres
AJT_DB_PASSWORD=postgres

# JWT (minimo 32 caracteres). Gerar com: openssl rand -base64 48
AJT_JWT_SECRET=coloque-aqui-uma-chave-bem-grande-e-aleatoria-de-pelo-menos-32-caracteres
AJT_JWT_EXPIRATION=86400000

# Chave AES-256 (Base64 de 32 bytes) para cifrar documentos de passageiros.
# Gerar com: openssl rand -base64 32
# ATENCAO: se trocar a chave, documentos ja cifrados nao poderao ser lidos.
AJT_CRYPTO_KEY=

# Origens do front liberadas no CORS (separadas por virgula)
AJT_CORS_ORIGINS=http://localhost:4200

# Bloqueio de login apos N falhas (por IP + usuario)
AJT_LOGIN_MAX_TENTATIVAS=5
AJT_LOGIN_BLOQUEIO_MINUTOS=15
